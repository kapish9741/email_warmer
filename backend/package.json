{
  "name": "email-warmer-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:endpoints": "tsx scripts/test-endpoints.ts",
    "templates:sample": "tsx scripts/sample-sequence.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.1",
    "imapflow": "^1.0.155",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.6.8",
    "nodemailer": "^6.9.10",
    "pino": "^8.19.0",
    "prisma": "^5.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
